# Greyskull Workout Tracker Configuration
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# --- Authentication ---
# Set your own username and password here.
# Auth is DISABLED if AUTH_PASSWORD is left empty.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# --- Flask ---
# Generate a random string for this (e.g. mash your keyboard)
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Database ---
DATABASE_PATH=workouts.db

# --- Session ---
# How many days you stay logged in before needing to re-enter your password
SESSION_LIFETIME_DAYS=7
